# Django Core Settings
SECRET_KEY=django-insecure-replace-this-key-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Setu DigiLocker Sandbox Configuration
# Base URL: https://dg-sandbox.setu.co for sandbox, https://dg.setu.co for production
SETU_BASE_URL=https://dg-sandbox.setu.co
SETU_CLIENT_ID=your_setu_client_id_here
SETU_CLIENT_SECRET=your_setu_client_secret_here
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id_here
SETU_REDIRECT_URL=http://localhost:5173/kyc/callback

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
